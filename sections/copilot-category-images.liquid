{% liquid
    assign design = section.settings.alt_design 
%}
{%- style -%}
  .category-image-copilot {
      position: relative;
      margin: 0 auto;
      padding: 100px 0;
  }
  .category-image-copilot__item-inner {
    display: flex;
    position: relative;
    overflow: hidden;
  }
  .category-image-copilot__container {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    gap: 8px;
  }
  {%- if design -%}
    .category-image-copilot__container {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 2px;
      }
  {%- else -%}
       .category-image-copilot__container {
          display: grid;
          grid-template-columns: 1fr 1fr 1fr 1fr;
          gap: 8px;
        }
  {%- endif -%}
  .copilot-section-categories__header {
    width: 100%;
    max-width: 1248px;
    margin: 0 auto 40px;
  }
   .copilot-section-categories__header p {
      font-family: 'OverusedGrotesk';
      font-weight: 400;
      font-size: 16px;
      line-height: 20px;
      letter-spacing: 0;
      width: 100%;
      max-width: 510px;
      margin: 0;
      text-align: center;
   }
  .swiper-button-next, .swiper-button-prev {
    color: #fff;
  }
  .category-image-copilot__item-inner:hover img {
    transform: scale(1.1);
    filter: greyscale(100%);
    -webkit-filter: grayscale(100%);
    -moz-filter: grayscale(100%);
    -ms-filter: grayscale(100%);
    -o-filter: grayscale(100%);
  }
  .category-image-copilot__item-inner {
    height: 100%;
  }
  .category-image-copilot__item-inner img {
      transition: transform .3s ease;
      object-fit: cover;
      width: 100%;
  }
  .category-image-copilot__item h2 {
    font-size: 24px !important;
    font-weight: 400 !important;
    margin: 8px 12px;
  }
  .category-image-copilot__item h2:hover ~ a .category-image-copilot__item-inner img,
  .category-image-copilot__item a:hover .category-image-copilot__item-inner img {
    transform: scale(1.1);
    filter: greyscale(100%);
    -webkit-filter: grayscale(100%);
    -moz-filter: grayscale(100%);
    -ms-filter: grayscale(100%);
    -o-filter: grayscale(100%);
  }
  @media(max-width: 768px){
    .category-image-copilot {
      padding: 20px 14.5px 10px;
    }
    .category-image-copilot__container {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-column-gap: 13px;
      grid-row-gap: 22px;
    }
    {%- if design -%}
      .category-image-copilot__container {
          display: grid;
          grid-template-columns: 1fr;
          grid-column-gap: 13px;
          grid-row-gap: 22px;
        }
    {%- else -%}
       .category-image-copilot__container {
          display: grid;
          grid-template-columns: 1fr 1fr;
          grid-column-gap: 13px;
          grid-row-gap: 22px;
        }
    {%- endif -%}
    .category-image-copilot__item>a{
      display: block;
    }
  }
  /* @media (max-width: 380px) {
    .category-image-copilot__item-inner img {
      height: 200px;
    }
  } */
{%- endstyle -%}

<div class="category-image-copilot swiper-container-image">
