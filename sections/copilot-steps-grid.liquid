<style>
  .copilot-steps-grid-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
  }

  .copilot-sg-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0;
    text-align: center;
    color: #ffffff;
  }

  .copilot-sg-header {
    margin-bottom: 40px;
  }

  .copilot-sg-title {
    font-family: 'OverusedGrotesk', sans-serif !important;
    font-weight: 300;
    font-size: 50px;
    line-height: 50px;
    letter-spacing: 0;
    color: #ffffff;
    text-transform: none;
    max-width: 360px;
    margin: 0 auto 20px;
  }

  .copilot-sg-subtitle {
    font-family: 'OverusedGrotesk', sans-serif !important;
    font-weight: 300;
    font-size: 16px;
    line-height: 20px;
    letter-spacing: 0;
    color: #ffffff;
    margin: 0 auto;
    max-width: 521px;
  }

  .copilot-sg-track {
    display: flex;
    justify-content: center;
    gap: 40px;
  }

  .copilot-sg-step {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    min-width: 0;
  }

  .copilot-sg-circle {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    border: 1px solid #ffffff;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 10px;
    font-family: 'OverusedGrotesk', sans-serif !important;
    font-weight: 300;
    font-size: 30px;
    color: #ffffff;
  }

  .copilot-sg-step-title {
    font-family: 'OverusedGrotesk', sans-serif !important;
    font-weight: 300;
    font-size: 28px;
    line-height: 28px;
    color: #ffffff;
    margin: 0 0 10px 0;
    text-transform: none;
  }

  .copilot-sg-step-text {
    font-family: 'OverusedGrotesk', sans-serif !important;
    font-weight: 300;
    font-size: 16px;
    line-height: 20px;
    color: #ffffff;
    margin: 0;
  }

  .copilot-sg-footer {
    margin-top: 40px;
  }

  .copilot-sg-footer-text {
    font-family: 'OverusedGrotesk', sans-serif !important;
    font-weight: 300;
    font-size: 16px;
    line-height: 20px;
    color: #ffffff;
    margin: 0 auto 20px;
    max-width: 521px;
  }

  .copilot-sg-button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-width: 184px;
    height: 60px;
    border-radius: 35px;
    background-color: #1A7A4A;
    border: 1px solid #1A7A4A;
    font-family: 'OverusedGrotesk', sans-serif !important;
    font-weight: 400;
    font-size: 16px;
    line-height: 20px;
    color: #ffffff;
    text-decoration: none;
    padding: 0 20px;
    transition: all 0.3s ease;
  }

  .copilot-sg-button:hover {
    background-color: #145e39;
    border-color: #145e39;
    transform: scale(1.02);
  }

  .copilot-sg-mobile-nav {
    display: none;
  }

  @media screen and (max-width: 768px) {

    .copilot-steps-grid-{{ section.id }} {
      padding-top: 40px !important;
      padding-bottom: 40px !important;
    }

    .copilot-sg-container {
      max-width: 100%;
      margin: 0 auto;
      padding: 0 20px;
    }

    .copilot-sg-title {
      font-size: 36px;
      line-height: 40px;
    }

    .copilot-sg-track {
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -ms-overflow-style: none;
      margin-left: -20px;
      margin-right: -20px;
      padding-left: 20px;
      padding-right: 20px;
      padding-bottom: 20px;
      width: calc(100% + 40px);
      justify-content: flex-start;
      gap: 20px;
      margin-bottom: 10px;
    }

    .copilot-sg-track::-webkit-scrollbar {
      display: none;
    }

    .copilot-sg-step {
      flex: 0 0 85vw;
      scroll-snap-align: center;
    }

    .copilot-sg-mobile-nav {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 20px;
      margin-bottom: 40px;
    }

    .copilot-sg-pagination {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .copilot-sg-bullet {
      width: 10px;
      height: 10px;
      border-radius: 10px;
      background-color: rgba(255, 255, 255, 0.3);
      cursor: pointer;
      transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .copilot-sg-bullet.active {
      width: 32px;
      background-color: #1A7A4A; /* Brand green */
    }

    .copilot-nav-arrow {
      background: none;
      border: 1px solid rgba(255, 255, 255, 0.3);
      border-radius: 50%;
      width: 40px;
      height: 40px;
      display: flex;
      justify-content: center;
      align-items: center;
      cursor: pointer;
      color: #ffffff;
      transition: all 0.3s ease;
      padding: 0;
    }
    .copilot-nav-arrow:hover {
      background-color: #ffffff;
      color: #213529;
    }
    .copilot-nav-arrow svg {
      width: 18px;
      height: 18px;
    }

    .copilot-sg-footer {
      margin-top: 20px;
    }
  }
</style>

<div class="copilot-steps-grid-{{ section.id }}">
  <div class="copilot-sg-container">
    <div class="copilot-sg-header">
      {% if section.settings.title != blank %}
        <h2 class="copilot-sg-title">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.subtitle != blank %}
        <p class="copilot-sg-subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>

    <div class="copilot-sg-track" id="track-{{ section.id }}">
      {% for block in section.blocks %}
        <div class="copilot-sg-step" {{ block.shopify_attributes }}>
          <div class="copilot-sg-circle">
            {{ block.settings.number }}
          </div>
          {% if block.settings.title != blank %}
            <h3 class="copilot-sg-step-title">{{ block.settings.title }}</h3>
          {% endif %}
          {% if block.settings.text != blank %}
            <p class="copilot-sg-step-text">{{ block.settings.text }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {% if section.blocks.size > 1 %}
      <!-- Mobile Navigation -->
      <div class="copilot-sg-mobile-nav">
        <button class="copilot-nav-arrow prev" id="prev-{{ section.id }}" aria-label="Anterior">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M15 18l-6-6 6-6"/>
          </svg>
        </button>

        <div class="copilot-sg-pagination" id="pagination-{{ section.id }}">
          {% for block in section.blocks %}
            <div
              class="copilot-sg-bullet {% if forloop.first %}active{% endif %}"
              data-index="{{ forloop.index0 }}"
            ></div>
          {% endfor %}
        </div>

        <button class="copilot-nav-arrow next" id="next-{{ section.id }}" aria-label="Siguiente">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M9 18l6-6-6-6"/>
          </svg>
        </button>
      </div>
    {% endif %}

    {% if section.settings.footer_text != blank or section.settings.button_text != blank %}
      <div class="copilot-sg-footer">
        {% if section.settings.footer_text != blank %}
          <p class="copilot-sg-footer-text">{{ section.settings.footer_text }}</p>
        {% endif %}
        {% if section.settings.button_text != blank %}
          <a href="{{ section.settings.button_link }}" class="copilot-sg-button">
            {{ section.settings.button_text }}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const track = document.getElementById('track-{{ section.id }}');
    const paginationContainer = document.getElementById('pagination-{{ section.id }}');
    const prevBtn = document.getElementById('prev-{{ section.id }}');
    const nextBtn = document.getElementById('next-{{ section.id }}');

    if (!track) return;

    const cards = Array.from(track.querySelectorAll('.copilot-sg-step'));
    const bullets = paginationContainer ? Array.from(paginationContainer.querySelectorAll('.copilot-sg-bullet')) : [];

    // Flechas en mobile
    if (prevBtn && nextBtn) {
      prevBtn.addEventListener('click', () => {
        const cardWidth = cards[0].offsetWidth;
        const gap = parseFloat(window.getComputedStyle(track).gap) || 0;
        track.scrollBy({ left: -(cardWidth + gap), behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', () => {
        const cardWidth = cards[0].offsetWidth;
        const gap = parseFloat(window.getComputedStyle(track).gap) || 0;
        track.scrollBy({ left: cardWidth + gap, behavior: 'smooth' });
      });
    }

    // Bullets en mobile
    if (bullets.length > 0) {
      bullets.forEach((bullet, index) => {
        bullet.addEventListener('click', () => {
          if (cards[index]) {
            const paddingLeft = parseFloat(window.getComputedStyle(track).paddingLeft) || 0;
            const offset = cards[index].offsetLeft - track.offsetLeft - paddingLeft;
            track.scrollTo({ left: offset, behavior: 'smooth' });
          }
        });
      });

      // Sincronizar bullets al scrollear
      let isScrolling;
      track.addEventListener('scroll', () => {
        window.clearTimeout(isScrolling);
        isScrolling = setTimeout(() => {
          const scrollLeft = track.scrollLeft;
          const paddingLeft = parseFloat(window.getComputedStyle(track).paddingLeft) || 0;

          let closestIndex = 0;
          let minDiff = Infinity;

          cards.forEach((card, index) => {
            const cardOffset = card.offsetLeft - track.offsetLeft - paddingLeft;
            const diff = Math.abs(cardOffset - scrollLeft);
            if (diff < minDiff) {
              minDiff = diff;
              closestIndex = index;
            }
          });

          bullets.forEach((b, i) => {
            if (i === closestIndex) b.classList.add('active');
            else b.classList.remove('active');
          });
        }, 50);
      });
    }
  });
</script>

{% schema %}
{
  "name": "Copilot Steps Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#213529"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Tu marca. Nuestra calidad."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Diseñamos y producimos tu etiqueta personalizada sobre nuestros productos. Tu identidad, la calidad que ya conocen tus clientes. A partir de 20 unidades por 300€ (pago único)"
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Bottom Text",
      "default": "¿Tienes dudas sobre el proceso? Escríbenos y te explicamos todo sin compromiso."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Me interesa la etiqueta personalizada"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step / Process",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Step Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Step Title",
          "default": "Nos mandas tu brief"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Step Text",
          "default": "Colores, logo, tipografía o simplemente una idea. Nosotros lo desarrollamos."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Copilot Steps Grid",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "number": "01",
            "title": "Nos mandas tu brief",
            "text": "Colores, logo, tipografía o simplemente una idea. Nosotros lo desarrollamos."
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "02",
            "title": "Diseño de etiqueta",
            "text": "Nuestro equipo crea la etiqueta adaptada a tu marca. Incluye revisiones hasta aprobación."
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "03",
            "title": "Producción y entrega",
            "text": "Mínimo 20 unidades. Producimos, etiquetamos y enviamos en el plazo acordado."
          }
        }
      ]
    }
  ]
}
{% endschema %}
