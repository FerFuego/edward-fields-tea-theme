<style>
  .copilot-products-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
  }

  .copilot-products-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0;
  }

  .copilot-products-header {
    margin-bottom: 20px;
  }

  .copilot-products-title {
    font-family: 'OverusedGrotesk', 'Overused Grotesk', sans-serif;
    font-weight: 300;
    font-style: normal;
    font-size: 50px;
    line-height: 50px;
    letter-spacing: 0%;
    color: #213529;
    margin: 0 0 16px 0;
  }

  .copilot-products-subtitle {
    font-family: 'OverusedGrotesk', 'Overused Grotesk', sans-serif;
    font-weight: 400;
    font-style: normal;
    font-size: 16px;
    line-height: 20px;
    letter-spacing: 0%;
    color: #213529;
    margin: 0;
    max-width: 600px;
  }

  .copilot-products-slider-wrapper {
    position: relative;
    width: 100%;
    padding-top: 100px; /* Space for the product bags to overflow */
  }

  .copilot-products-track {
    display: flex;
    gap: 20px;
    justify-content: flex-start;
    flex-wrap: nowrap; /* En desktop bajan de línea si no caben */
    width: 100%;
  }

  .copilot-product-card {
    position: relative;
    width: 306px;
    height: 306px;
    border-radius: 20px;
    border: 1px solid rgba(33, 53, 41, 0.2);
    background-color: #FBFAF3;
    padding: 120px 20px 24px 20px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: transform 0.3s ease;
  }

  .copilot-product-card:hover {
    transform: translateY(-5px);
  }

  .copilot-product-link {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 10;
  }

  .copilot-product-image {
    position: absolute;
    top: -80px;
    left: 50%;
    transform: translateX(-50%);
    width: 160px;
    height: 190px;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    z-index: 2;
  }

  .copilot-product-image img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: drop-shadow(0px 10px 15px rgba(0,0,0,0.15));
  }

  .copilot-product-image svg {
    width: 100%;
    height: 100%;
    background-color: #e2e2e2;
    border-radius: 10px;
  }

  .copilot-product-title {
    font-family: 'OverusedGrotesk', 'Overused Grotesk', sans-serif;
    font-weight: 400;
    font-style: normal;
    font-size: 20px;
    line-height: 24px;
    letter-spacing: 0%;
    color: #213529;
    margin: 0 0 12px 0;
  }

  .copilot-product-text {
    font-family: 'OverusedGrotesk', 'Overused Grotesk', sans-serif;
    font-weight: 400;
    font-style: normal;
    font-size: 16px;
    line-height: 20px;
    letter-spacing: 0%;
    color: #213529;
    margin: 0 0 auto 0; /* Pushes the following elements to the bottom */
  }

  .copilot-product-subtext {
    font-family: 'OverusedGrotesk', 'Overused Grotesk', sans-serif;
    font-weight: 400;
    font-style: normal;
    font-size: 14px;
    line-height: 20px;
    color: #213529;
    margin: 12px 0 0 0;
    opacity: 0.9;
  }

  .copilot-product-tag {
    background-color: #213529;
    color: #ffffff;
    font-family: 'OverusedGrotesk', 'Overused Grotesk', sans-serif;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 6px 16px;
    border-radius: 20px;
    margin-top: 12px;
    z-index: 11; /* Above the absolute link to allow hover states if needed */
  }

  .copilot-products-mobile-nav {
    display: none;
  }

  @media screen and (max-width: 1024px) {
    .copilot-products-container {
      max-width: 100%;
      margin: 0 auto;
      padding: 0 20px;
    }
    /* En tablet/mobile cambiamos a slider */
    .copilot-products-slider-wrapper {
      margin-left: -20px;
      margin-right: -20px;
      width: calc(100% + 40px);
    }
    .copilot-products-track {
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -ms-overflow-style: none;
      padding-left: 20px;
      padding-right: 20px;
      padding-bottom: 20px;
    }
    .copilot-products-track::-webkit-scrollbar {
      display: none;
    }
    .copilot-product-card {
      flex: 0 0 85vw;
      max-width: 306px;
      scroll-snap-align: start;
    }
    .copilot-products-mobile-nav {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 20px;
      margin-top: 10px;
      padding: 0 20px;
    }

    .copilot-products-pagination {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .copilot-products-bullet {
      width: 10px;
      height: 10px;
      border-radius: 10px;
      background-color: #D1E0D5;
      cursor: pointer;
      transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .copilot-products-bullet.active {
      width: 32px;
      background-color: #1A7A4A;
    }

    .copilot-nav-arrow {
      background: none;
      border: 1px solid rgba(33, 53, 41, 0.2);
      border-radius: 50%;
      width: 40px;
      height: 40px;
      display: flex;
      justify-content: center;
      align-items: center;
      cursor: pointer;
      color: #213529;
      transition: all 0.3s ease;
      padding: 0;
    }
    .copilot-nav-arrow:hover {
      background-color: #213529;
      color: #ffffff;
    }
    .copilot-nav-arrow svg {
      width: 18px;
      height: 18px;
    }
  }

  @media screen and (max-width: 768px) {
    .copilot-products-title {
      font-size: 36px;
      line-height: 40px;
    }
    .copilot-product-card {
      flex: 0 0 85vw;
    }
  }
</style>

<div class="copilot-products-{{ section.id }}">
  <div class="copilot-products-container">
    <div class="copilot-products-header">
      {% if section.settings.title != blank %}
        <h2 class="copilot-products-title">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.subtitle != blank %}
        <p class="copilot-products-subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>

    <div class="copilot-products-slider-wrapper">
      <div class="copilot-products-track" id="track-{{ section.id }}">
        {% for block in section.blocks %}
          <div class="copilot-product-card" {{ block.shopify_attributes }}>
            {% if block.settings.link != blank %}
              <a
                href="{{ block.settings.link }}"
                class="copilot-product-link"
                aria-label="{{ block.settings.title | escape }}"
              ></a>
            {% endif %}

            <div class="copilot-product-image">
              {% if block.settings.image != blank %}
                <img
                  src="{{ block.settings.image | image_url: height: 400 }}"
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                >
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}
            </div>

            {% if block.settings.title != blank %}
              <h3 class="copilot-product-title">{{ block.settings.title }}</h3>
            {% endif %}

            {% if block.settings.text != blank %}
              <div class="copilot-product-text">{{ block.settings.text }}</div>
            {% endif %}

            {% if block.settings.subtext != blank %}
              <div class="copilot-product-subtext">{{ block.settings.subtext }}</div>
            {% endif %}

            {% if block.settings.tag != blank %}
              <div class="copilot-product-tag">{{ block.settings.tag }}</div>
            {% endif %}
          </div>
        {% endfor %}
      </div>

      <!-- Mobile Navigation (Arrows + Bullets) -->
      <div class="copilot-products-mobile-nav">
        <button class="copilot-nav-arrow prev" id="prev-{{ section.id }}" aria-label="Anterior">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M15 18l-6-6 6-6"/>
          </svg>
        </button>

        <div class="copilot-products-pagination" id="pagination-{{ section.id }}">
          {% for block in section.blocks %}
            <div
              class="copilot-products-bullet {% if forloop.first %}active{% endif %}"
              data-index="{{ forloop.index0 }}"
            ></div>
          {% endfor %}
        </div>

        <button class="copilot-nav-arrow next" id="next-{{ section.id }}" aria-label="Siguiente">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M9 18l6-6-6-6"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const track = document.getElementById('track-{{ section.id }}');
    const paginationContainer = document.getElementById('pagination-{{ section.id }}');
    const prevBtn = document.getElementById('prev-{{ section.id }}');
    const nextBtn = document.getElementById('next-{{ section.id }}');

    if (!track) return;

    const cards = Array.from(track.querySelectorAll('.copilot-product-card'));
    const bullets = paginationContainer
      ? Array.from(paginationContainer.querySelectorAll('.copilot-products-bullet'))
      : [];

    // Lógica para las flechas en mobile
    if (prevBtn && nextBtn) {
      prevBtn.addEventListener('click', () => {
        const cardWidth = cards[0].offsetWidth;
        const gap = parseFloat(window.getComputedStyle(track).gap) || 0;
        track.scrollBy({ left: -(cardWidth + gap), behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', () => {
        const cardWidth = cards[0].offsetWidth;
        const gap = parseFloat(window.getComputedStyle(track).gap) || 0;
        track.scrollBy({ left: cardWidth + gap, behavior: 'smooth' });
      });
    }

    // Lógica para los bullets en mobile
    if (bullets.length > 0) {
      bullets.forEach((bullet, index) => {
        bullet.addEventListener('click', () => {
          if (cards[index]) {
            const paddingLeft = parseFloat(window.getComputedStyle(track).paddingLeft) || 0;
            const offset = cards[index].offsetLeft - track.offsetLeft - paddingLeft;
            track.scrollTo({ left: offset, behavior: 'smooth' });
          }
        });
      });

      // Sincronizar bullets al scrollear
      let isScrolling;
      track.addEventListener('scroll', () => {
        window.clearTimeout(isScrolling);
        isScrolling = setTimeout(() => {
          const scrollLeft = track.scrollLeft;
          const paddingLeft = parseFloat(window.getComputedStyle(track).paddingLeft) || 0;

          let closestIndex = 0;
          let minDiff = Infinity;

          cards.forEach((card, index) => {
            const cardOffset = card.offsetLeft - track.offsetLeft - paddingLeft;
            const diff = Math.abs(cardOffset - scrollLeft);
            if (diff < minDiff) {
              minDiff = diff;
              closestIndex = index;
            }
          });

          bullets.forEach((b, i) => {
            if (i === closestIndex) b.classList.add('active');
            else b.classList.remove('active');
          });
        }, 50);
      });
    }
  });
</script>

{% schema %}
