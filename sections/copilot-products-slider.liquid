<style>
  .copilot-products-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
  }

  .copilot-products-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0;
  }

  .copilot-products-header {
    margin-bottom: 20px;
  }

  .copilot-products-title {
    font-family: 'OverusedGrotesk', sans-serif !important;
    font-weight: 300;
    font-style: normal;
    font-size: 50px;
    line-height: 50px;
    letter-spacing: 0;
    color: #213529;
    margin: 0 0 16px 0;
    max-width: 395px;
    text-transform: none;
  }

  .copilot-products-subtitle {
    font-family: 'OverusedGrotesk', sans-serif !important;
    font-weight: 400;
    font-style: normal;
    font-size: 16px;
    line-height: 20px;
    letter-spacing: 0;
    color: #213529;
    margin: 0;
    max-width: 385px;
  }

  .copilot-products-slider-wrapper {
    position: relative;
    width: 100%;
    padding-top: 100px; /* Space for the product bags to overflow */
  }

  .copilot-products-track {
    display: flex;
    gap: 40px;
    justify-content: flex-start;
    flex-wrap: nowrap; /* En desktop bajan de línea si no caben */
    width: 100%;
  }

  .copilot-product-card {
    position: relative;
    width: 306px;
    height: 386px;
    border-radius: 20px;
    border: 1px solid #213529;
    background-color: #FBFAF3;
    padding: 120px 20px 24px 20px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: transform 0.3s ease;
  }

  .copilot-product-card:hover {
    transform: translateY(-5px);
  }

  .copilot-product-link {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 10;
  }

  .copilot-product-image {
    position: absolute;
    top: -80px;
    left: 50%;
    transform: translateX(-50%);
    width: 160px;
    height: 190px;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    z-index: 2;
  }

  .copilot-product-image img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: drop-shadow(0px 10px 15px rgba(0,0,0,0.15));
  }

  .copilot-product-image svg {
    width: 100%;
    height: 100%;
    background-color: #e2e2e2;
    border-radius: 10px;
  }

  .copilot-product-title {
    font-family: 'OverusedGrotesk', sans-serif !important;
    font-weight: 400;
    font-style: normal;
    font-size: 20px;
    line-height: 24px;
    letter-spacing: 0%;
    color: #213529;
    margin: 0 0 12px 0;
    text-transform: none;
  }

  .copilot-product-text {
    font-family: 'OverusedGrotesk', sans-serif !important;
    font-weight: 400;
    font-style: normal;
    font-size: 16px;
    line-height: 20px;
    letter-spacing: 0%;
    color: #213529;
    margin: 0 0 auto 0; /* Pushes the following elements to the bottom */
  }

  .copilot-product-subtext {
    font-family: 'OverusedGrotesk', sans-serif !important;
    font-weight: 400;
    font-style: normal;
    font-size: 14px;
    line-height: 20px;
    color: #213529;
    margin: 12px 0 0 0;
    opacity: 0.9;
  }

  .copilot-product-tag {
    background-color: #213529;
    color: #ffffff;
    font-family: 'OverusedGrotesk', sans-serif !important;
    font-weight: 400;
    font-size: 12px;
    line-height: 20px;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 6px 26px;
    border-radius: 20px;
    margin-top: 12px;
    z-index: 4; /* Above the absolute link to allow hover states if needed */
  }

  .copilot-product-tag__empty {
    font-size: 12px;
    line-height: 20px;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 6px 26px;
    border-radius: 20px;
    margin-top: 12px;
  }

  .copilot-products-mobile-nav {
    display: none;
  }

  @media screen and (max-width: 1024px) {
    .copilot-products-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: 40px !important;
    }
    .copilot-products-container {
      max-width: 100%;
      margin: 0 auto;
      padding: 0 20px;
    }
    /* En tablet/mobile cambiamos a slider */
    .copilot-products-slider-wrapper {
      margin-left: -20px;
      margin-right: -20px;
      padding-top: 60px;
      width: calc(100% + 40px);
    }
    .copilot-products-track {
      flex-wrap: nowrap;
      padding-bottom: 20px;
      padding-top: 100px;
      margin: 0 50px;
    }
    .copilot-products-track::-webkit-scrollbar {
      display: none;
    }
    .copilot-product-card {
      flex: 0 0 85vw;
      max-width: 260px;
    }
    .copilot-products-mobile-nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      top: 50%;
      padding: 0 10px;
      position: absolute;
      width: 100%;
      z-index: 2;
    }

    .copilot-products-pagination {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .copilot-products-bullet {
      width: 10px;
      height: 10px;
      border-radius: 10px;
      background-color: #D1E0D5;
      cursor: pointer;
      transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .copilot-products-bullet.active {
      width: 32px;
      background-color: #1A7A4A;
    }

    .copilot-products-mobile-nav .copilot-nav-arrow {
      background: #1A7A4A !important;
      border: 1px solid rgba(33, 53, 41, 0.2);
      border-radius: 50%;
      width: 40px;
      height: 40px;
      display: flex;
      justify-content: center;
      align-items: center;
      cursor: pointer;
      color: #FFF;
      transition: all 0.3s ease;
      padding: 0;
    }
    .copilot-products-mobile-nav .copilot-nav-arrow:hover {
      background-color: #213529;
      color: #ffffff;
    }
    .copilot-nav-arrow svg {
      width: 18px;
      height: 18px;
    }
  }

  @media screen and (max-width: 768px) {
    .copilot-products-title {
      font-size: 36px;
      line-height: 40px;
    }
    .copilot-product-card {
      flex: 0 0 85vw;
    }
  }
  .copilot-products-swiper {
    overflow: visible;
  }

  .copilot-products-swiper .swiper-wrapper {
    align-items: stretch;
  }

  .copilot-products-swiper .swiper-slide {
    width: auto;
  }

  @media (min-width:1025px){

    .copilot-products-swiper .swiper-wrapper{
      display:flex;
      gap:20px;
    }

    .copilot-products-swiper .swiper-slide{
      width:306px !important;
      flex-shrink:0;
    }

  }

  @media (max-width:1024px){

    .copilot-products-swiper .swiper-slide{
      width:100% !important;
      display:flex;
      justify-content:center;
    }

    .copilot-product-card{
      width:85vw;
      max-width:260px;
    }

    .copilot-products-swiper .swiper-wrapper {
      scroll-snap-type: none !important;
    }
  }
</style>

<div class="copilot-products-{{ section.id }}">
  <div class="copilot-products-container">
    <div class="copilot-products-header">
      {% if section.settings.title != blank %}
        <h2 class="copilot-products-title">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.subtitle != blank %}
        <p class="copilot-products-subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>

    <div class="copilot-products-slider-wrapper">
      <div class="swiper copilot-products-swiper" id="track-{{ section.id }}">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            <div class="swiper-slide">
              <div class="copilot-product-card" {{ block.shopify_attributes }}>
                {% if block.settings.link != blank %}
                  <a
                    href="{{ block.settings.link }}"
                    class="copilot-product-link"
                    aria-label="{{ block.settings.title | escape }}"
                  ></a>
                {% endif %}

                <div class="copilot-product-image">
                  {% if block.settings.image != blank %}
                    <img
                      src="{{ block.settings.image | image_url: height: 400 }}"
                      alt="{{ block.settings.title | escape }}"
                      loading="lazy"
                    >
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag }}
                  {% endif %}
                </div>

                {% if block.settings.title != blank %}
                  <h3 class="copilot-product-title">{{ block.settings.title }}</h3>
                {% endif %}

                {% if block.settings.text != blank %}
                  <div class="copilot-product-text">{{ block.settings.text }}</div>
                {% endif %}

                {% if block.settings.subtext != blank %}
                  <div class="copilot-product-subtext">{{ block.settings.subtext }}</div>
                {% endif %}

                {% if block.settings.tag != blank %}
                  <div class="copilot-product-tag">{{ block.settings.tag }}</div>
                {% else %}
                  <div class="copilot-product-tag__empty">&nbsp;</div>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      <!-- Mobile Navigation (Arrows + Bullets) -->
      <div class="copilot-products-mobile-nav">
        <button class="copilot-nav-arrow prev" id="prev-{{ section.id }}" aria-label="Anterior">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M15 18l-6-6 6-6"/>
          </svg>
        </button>

        {% comment %} <div class="copilot-products-pagination" id="pagination-{{ section.id }}">
          {% for block in section.blocks %}
            <div
              class="copilot-products-bullet {% if forloop.first %}active{% endif %}"
              data-index="{{ forloop.index0 }}"
            ></div>
          {% endfor %}
        </div> {% endcomment %}

        <button class="copilot-nav-arrow next" id="next-{{ section.id }}" aria-label="Siguiente">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M9 18l6-6-6-6"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {

    const isMobile = window.innerWidth <= 1024;

    if (!isMobile) return;

    const swiper = new Swiper('#track-{{ section.id }}', {
      loop: true,
      slidesPerView: 1,
      spaceBetween: 20,
      speed: 500,
      grabCursor: true,
      watchSlidesProgress: true,
      navigation: {
        nextEl: '#next-{{ section.id }}',
        prevEl: '#prev-{{ section.id }}'
      }
    });

  });
</script>

