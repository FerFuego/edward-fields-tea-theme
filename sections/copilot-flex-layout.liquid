{% comment %}
  Flexible Layout Section con nested_container que permite bloques hijos (text, image, button)
{% endcomment %}

{%- liquid
  assign grid_columns = section.settings.column_count | default: 3
  assign grid_rows = section.settings.rows_count | default: 3
  assign layout_type = section.settings.layout
  assign is_grid = false
  assign is_flex_grid = false

  if layout_type == "grid"
    assign is_grid = true
  elsif layout_type == "flex-grid"
    assign is_flex_grid = true
  endif
-%}

{% style %}
  .contact-form__input.error {
    border: 1px solid red;
  }
  .contact-form__form-row {
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
  }
  .field-error {
    color: red;
    font-size: 12px;
    margin-top: 5px;
    padding-left: 30px;
  }
   .contact-form__success {
      display: flex;
      align-items: center;
      gap: var(--gap-xs);
      font-size: 30px;
      color: #3d4982;
      line-height: 32px;
      font-weight: 700;
  }
  .contact-form__checkbox.error {
    outline: 2px solid red;
  }
  .video-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .video-poster {
    position: relative;
    cursor: pointer;
    width: 100%;
    height: 100%;
  }

  .video-poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .video-play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 70px;
    height: 70px;
    border-radius: 50%;
    border: none;
    font-size: 30px;
    cursor: pointer;
    color: #fff;
    background-color: rgba(0, 0, 0, 0.3);
  }
{% endstyle %}

<section class="custom-flex-layout {{ section.settings.custom_class }}" style="
  {% if is_grid %}
    display: grid;
    grid-template-columns: repeat({{ grid_columns }}, 1fr);
    grid-template-rows: repeat({{ grid_rows }}, auto);
    grid-auto-flow: dense;
  {% elsif is_flex_grid %}
    display: flex;
    flex-wrap: wrap;
    --columns: {{ grid_columns }};
    --gap: {{ section.settings.gap }};
  {% else %}
    display: {{ layout_type }};
    flex-direction: {{ section.settings.flex_direction }};
  {% endif %}
  justify-content: {{ section.settings.justify_content }};
  align-items: {{ section.settings.align_items }};
  background-color: {{ section.settings.background_color }};
  border: {{ section.settings.border }};
  width: {{ section.settings.width }};
  height: {{ section.settings.height }};
  padding: {{ section.settings.padding }};
  margin: {{ section.settings.margin }};
  gap: {{ section.settings.gap }};">

  {%- assign containers = section.blocks | where: "type", "container" -%}

  {%- for container in containers -%}
    {%- liquid
      assign grid_position = container.settings.grid_position | default: "auto/auto"
      assign position_parts = grid_position | split: '/'
      assign grid_column = position_parts[0] | default: 'auto'
      assign grid_row = position_parts[1] | default: 'auto'
      
      if is_flex_grid
        assign flex_position = grid_position | split: '/' | join: '-'
        assign flex_order = container.settings.flex_order | default: 0
      endif
    -%}

    {% assign container_link = container.settings.link %}

    {% if container_link != blank %}
      <a 
        href="{{ container_link }}"
        id="{{ container.settings.container_name }}"
        class="layout-block layout-block--container layout-block--link"
        {% if container.settings.link_new_tab %}
          target="_blank"
          rel="noopener"
        {% endif %}
        style="
          display: {{ container.settings.layout }};
          flex-direction: {{ container.settings.flex_direction }};
          justify-content: {{ container.settings.justify_content }};
          align-items: {{ container.settings.align_items }};
          background-color: {{ container.settings.background_color }};
          border: {{ container.settings.border }};
          width: {{ container.settings.width }};
          height: {{ container.settings.height }};
          padding: {{ container.settings.padding }};
          margin: {{ container.settings.margin }};
          gap: {{ container.settings.gap }};
          text-decoration:none;
          color:inherit;
          {% if is_grid %}
            grid-column: {{ grid_column }};
            grid-row: {{ grid_row }};
          {% elsif is_flex_grid %}
            flex: 0 0 calc((100% / var(--columns)) - var(--gap));
            min-width: calc((100% / var(--columns)) - var(--gap));
            order: {{ flex_order }};
          {% endif %}
        "
      >
    {% else %}
      <div 
        id="{{ container.settings.container_name }}"
        class="layout-block layout-block--container"
        style="
          display: {{ container.settings.layout }};
          flex-direction: {{ container.settings.flex_direction }};
          justify-content: {{ container.settings.justify_content }};
          align-items: {{ container.settings.align_items }};
          background-color: {{ container.settings.background_color }};
          border: {{ container.settings.border }};
          width: {{ container.settings.width }};
          height: {{ container.settings.height }};
          padding: {{ container.settings.padding }};
          margin: {{ container.settings.margin }};
          gap: {{ container.settings.gap }};
          {% if is_grid %}
            grid-column: {{ grid_column }};
            grid-row: {{ grid_row }};
          {% elsif is_flex_grid %}
            flex: 0 0 calc((100% / var(--columns)) - var(--gap));
            min-width: calc((100% / var(--columns)) - var(--gap));
            order: {{ flex_order }};
          {% endif %}
        "
      >
    {% endif %}

      {% render 'copilot-block', container: container, blocks: section.blocks %}

    {% if container_link != blank %}
      </a>
    {% else %}
      </div>
    {% endif %}

  {%- endfor -%}

  {% comment %} POPUP {% endcomment %}
   {%- for b in section.blocks -%}
    {%- if b.type == 'popup_content' -%}
      {%- liquid
        assign htag = b.settings.heading_tag | default: 'h2'
      -%}
      <div
        id="copilot-popup--{{ b.settings.popup_id }}"
        class="copilot-popup"
        role="dialog"
        aria-modal="true"
        style="display:none; position:fixed; inset:0; z-index:9999; align-items:center; justify-content:center; background-color:{{ b.settings.overlay_color }};"
        {{ b.shopify_attributes }}
      >
        <div
          class="copilot-popup__inner"
          style="
            background-color: {{ b.settings.background_color }};
            border-radius: {{ b.settings.border_radius }};
            padding: {{ b.settings.padding }};
            max-width: {{ b.settings.max_width }};
            width: 90%;
            position: relative;
            max-height: 90vh;
            overflow-y: auto;
          "
        >
          {%- if b.settings.heading != blank -%}
            <{{ htag }}
              style="color:{{ b.settings.heading_color }}; font-size:{{ b.settings.heading_font_size }}; margin:0 0 12px 0;"
            >
              {{ b.settings.heading }}
            </{{ htag }}>
          {%- endif -%}

          {%- if b.settings.text != blank -%}
            <div style="color:{{ b.settings.text_color }}; font-size:{{ b.settings.text_font_size }}; margin-bottom:16px;">
              {{ b.settings.text }}
            </div>
          {%- endif -%}

          {%- if b.settings.custom_html != blank -%}
            <div class="copilot-popup__custom-html">
              {{ b.settings.custom_html }}
            </div>
          {%- endif -%}

          <button
            type="button"
            class="copilot-popup-close"
            data-popup-close="{{ b.settings.popup_id }}"
            aria-label="Cerrar"
            style="position:absolute; top:12px; right:16px; background:none; border:none; cursor:pointer; font-size:22px; line-height:1; color:{{ b.settings.close_btn_color }};"
          >&#x2715;</button>
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}
  {% comment %} ENDPOPUP {% endcomment %}
</section>
<script>
  document.addEventListener('DOMContentLoaded', function () {

    document.querySelectorAll('.video-wrapper').forEach(wrapper => {

      const poster = wrapper.querySelector('.js-video-poster');
      const iframe = wrapper.querySelector('.js-video-iframe');

      if (!poster || !iframe) return;

      poster.addEventListener('click', function () {

        iframe.src = iframe.dataset.src;

        poster.style.display = 'none';
        iframe.style.display = 'block';

      });
    });
  });
</script>
<script>
  (function() {
    function initCopilotPopups() {
      // Abrir
      document.querySelectorAll('.copilot-popup-trigger').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var id = btn.getAttribute('data-popup-target');
          var popup = document.getElementById('copilot-popup--' + id);
          if (popup) {
            popup.style.display = 'flex';
            document.body.style.overflow = 'hidden';
          }
        });
      });

      // Cerrar con botón X
      document.querySelectorAll('.copilot-popup-close').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var id = btn.getAttribute('data-popup-close');
          closePopup(id);
        });
      });

      // Cerrar clickeando el overlay
      document.querySelectorAll('.copilot-popup').forEach(function(popup) {
        popup.addEventListener('click', function(e) {
          if (e.target === popup) {
            var id = popup.id.replace('copilot-popup--', '');
            closePopup(id);
          }
        });
      });

      // Cerrar con Escape
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          document.querySelectorAll('.copilot-popup').forEach(function(popup) {
            if (popup.style.display === 'flex') {
              var id = popup.id.replace('copilot-popup--', '');
              closePopup(id);
            }
          });
        }
      });
    }

    function closePopup(id) {
      var popup = document.getElementById('copilot-popup--' + id);
      if (popup) {
        popup.style.display = 'none';
        document.body.style.overflow = '';
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCopilotPopups);
    } else {
      initCopilotPopups();
    }
  })();
</script>

