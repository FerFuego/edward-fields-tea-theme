<style>
  .copilot-cta-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
  }

  .copilot-cta-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0;
  }

  .copilot-cta-track {
    display: flex;
    gap: 20px;
    flex-wrap: nowrap;
    width: 100%;
  }

  .copilot-cta-card {
    flex: 0 0 100%;
    background-color: #213529; /* Background from prompt */
    border-radius: 20px;
    padding: 30px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    box-sizing: border-box;
    position: relative;
  }

  .copilot-cta-image {
    flex-shrink: 0;
    width: 140px; /* Adjust based on typical product image size */
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .copilot-cta-image img {
    max-width: 100%;
    height: auto;
    object-fit: contain;
    position: absolute;
    top: -42px;
    width: 190px;
  }

  .copilot-cta-content {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: left; /* Left align on desktop to match the design */
  }

  .copilot-cta-title {
    font-family: 'OverusedGrotesk', sans-serif !important;
    font-weight: 400;
    font-style: normal;
    font-size: 20px;
    line-height: 24px;
    letter-spacing: 0;
    color: #ffffff;
    margin: 0 0 8px 0;
    text-transform: none;
  }

  .copilot-cta-subtitle {
    font-family: 'OverusedGrotesk', sans-serif !important;
    font-weight: 400;
    font-style: normal;
    font-size: 16px;
    line-height: 20px;
    letter-spacing: 0;
    color: #FBFAF3;
    margin: 0;
    max-width: 484px;
  }

  .copilot-cta-button-container {
    flex-shrink: 0;
  }

  .copilot-cta-button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-width: 184px;
    height: 60px;
    border-radius: 35px;
    background-color: #1A7A4A;
    border: 1px solid #1A7A4A;
    font-family: 'OverusedGrotesk', sans-serif !important;
    font-weight: 400;
    font-size: 16px;
    line-height: 22px;
    letter-spacing: 0;
    color: #ffffff;
    text-decoration: none;
    transition: all 0.3s ease;
    padding: 0 20px;
    box-sizing: border-box;
  }

  .copilot-cta-button:hover {
    background-color: #145e39; /* Darker green for hover */
    border-color: #145e39;
  }

  .copilot-cta-mobile-nav {
    display: none;
  }

  @media screen and (max-width: 1024px) {

    .copilot-cta-container {
      max-width: 100%;
      margin: 0 auto;
      padding: 0 20px;
    }
    .copilot-cta-track {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -ms-overflow-style: none;
      /* Full width peeking */
      margin-left: -20px;
      margin-right: -20px;
      padding-left: 20px;
      padding-right: 20px;
      padding-bottom: 20px;
      width: calc(100% + 40px);
    }
    .copilot-cta-track::-webkit-scrollbar {
      display: none;
    }
    
    .copilot-cta-card {
      /* En mobile este es un slider, items siguientes se asomen */
      flex: 0 0 85vw;
      scroll-snap-align: start;
      /* On mobile, stack vertically */
      flex-direction: column;
      text-align: center;
      padding: 40px 20px;
      gap: 20px;
    }

    .copilot-cta-content {
      text-align: center; /* Center text on mobile */
    }

    .copilot-cta-subtitle {
      margin: 0 auto;
    }

    /* Solo mostrar la navegación si hay más de 1 bloque (gestionado por Liquid) */
    .copilot-cta-mobile-nav {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 20px;
      margin-top: 10px;
    }

    .copilot-cta-pagination {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .copilot-cta-bullet {
      width: 10px;
      height: 10px;
      border-radius: 10px;
      background-color: #D1E0D5;
      cursor: pointer;
      transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .copilot-cta-bullet.active {
      width: 32px;
      background-color: #1A7A4A;
    }

    .copilot-nav-arrow {
      background: none;
      border: 1px solid rgba(33, 53, 41, 0.2);
      border-radius: 50%;
      width: 40px;
      height: 40px;
      display: flex;
      justify-content: center;
      align-items: center;
      cursor: pointer;
      color: #213529;
      transition: all 0.3s ease;
      padding: 0;
    }
    .copilot-nav-arrow:hover {
      background-color: #213529;
      color: #ffffff;
    }
    .copilot-nav-arrow svg {
      width: 18px;
      height: 18px;
    }
  }

  @media screen and (max-width: 768px) {
    .copilot-cta-title {
      font-size: 20px; /* Keeps same size as requested, or slightly larger if needed */
    }
  }
</style>

<div class="copilot-cta-{{ section.id }}">
  <div class="copilot-cta-container">
    <div class="copilot-cta-track" id="track-{{ section.id }}">
      {% for block in section.blocks %}
        <div class="copilot-cta-card" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <div class="copilot-cta-image">
              <img src="{{ block.settings.image | image_url: width: 300 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
            </div>
          {% endif %}
          
          <div class="copilot-cta-content">
            {% if block.settings.title != blank %}
              <h3 class="copilot-cta-title" {% if block.settings.text_center %}style="text-align: center;"{% endif %}>
                {{ block.settings.title }}
              </h3>
            {% endif %}
            {% if block.settings.subtitle != blank %}
              <p class="copilot-cta-subtitle" {% if block.settings.text_center %}style="text-align: center; margin: 0 auto;"{% endif %}>
                {{ block.settings.subtitle }}
              </p>
            {% endif %}
          </div>
          
          {% if block.settings.button_text != blank %}
            <div class="copilot-cta-button-container">
              <a href="{{ block.settings.button_link }}" class="copilot-cta-button">
                {{ block.settings.button_text }}
              </a>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {% if section.blocks.size > 1 %}
    <!-- Mobile Navigation (Arrows + Bullets) -->
    <div class="copilot-cta-mobile-nav">
      <button class="copilot-nav-arrow prev" id="prev-{{ section.id }}" aria-label="Anterior">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      
      <div class="copilot-cta-pagination" id="pagination-{{ section.id }}">
        {% for block in section.blocks %}
          <div class="copilot-cta-bullet {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}"></div>
        {% endfor %}
      </div>
      
      <button class="copilot-nav-arrow next" id="next-{{ section.id }}" aria-label="Siguiente">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Copilot CTA",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "transparent"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "cta_banner",
      "name": "CTA Banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product/Icon Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "¿Necesitas algo diferente?"
        },
        {
          "type": "textarea",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Tenemos todo el catálogo disponible y podemos desarrollar nuevos formatos a medida. Cuéntanos qué necesitas."
        },
        {
          "type": "checkbox",
          "id": "text_center",
          "label": "Center text on desktop",
          "default": false
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Consultar catálogo"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Copilot CTA",
      "blocks": [
        {
          "type": "cta_banner"
        }
      ]
    }
  ]
}
{% endschema %}
