{% style %}
  .copilot-video-stories {
    background-color: #213529;
    padding: 80px 20px;
    margin: 100px 0 0;
    overflow-x: hidden;
  }

  .copilot-video-stories__container {
    max-width: 1165px;
    margin: 0 auto;
  }

  .copilot-video-stories__title {
    font-family: 'OverusedGrotesk', sans-serif !important;
    color: #fff;
    font-size: 50px;
    font-weight: 300 !important;
    line-height: 50px;
    text-align: center;
    margin: 0 auto 20px;
    max-width: 415px;
    text-transform: none !important;
  }

  .copilot-video-stories__subtitle {
    font-family: 'OverusedGrotesk', sans-serif !important;
    color: #fff;
    text-align: center;
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    text-align: center;
    margin: 0 auto 40px;
    max-width: 480px;
  }

  .copilot-video-stories__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .copilot-video-card {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
  }

  .copilot-video-card video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 20px;
  }

  .copilot-video-card__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.5);
    color: white;
    border: none;
    font-size: 22px;
    cursor: pointer;
  }

  .copilot-video-card__inner {
    position: relative;
    height: 528px;
    border-radius: 20px;
    backdrop-filter: blur(10px);
    background: #FFFFFF0D;
    -webkit-backdrop-filter: blur(10px);
    box-shadow:
        0px 8px 72px -5px #0000001A,
        0px 2px 30px 0px #0000000D,
        0px 2px 20px 2px #3535350D inset,
        0px 0px 5px 0px #FFFFFF26 inset,
        -1px -1px 0px 0px #FFFFFF66 inset,
        1px 0.5px 0px 0px #FFFFFF99 inset;
  }
  .copilot-video-card__video-number {
    position: absolute;
    display: flex;
    justify-content: center;
    align-items: center;
    color: #FBFAF3;
    font-family: 'OverusedGrotesk', sans-serif !important;
    font-weight: 300;
    font-size: 40px;
    line-height: 60px;
    text-align: center;
    top: 20px;
    right: 20px;
    border: 1px solid #fff;
    padding: 0 0 5px 0;
    border-radius: 50px;
    height: 60px;
    width: 60px;
    z-index: 2;
  }
  .copilot-video-card__poster {
    position: absolute;
    border-radius: 20px;
    filter: blur(2px);
    transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1);
  }
  @media (hover: hover) {
    .copilot-video-card__poster:hover {
      transform: scale(1.05);
    }
  }
  .copilot-video-card__video-content {
    background: #000000;
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.8) 41%, rgba(255, 255, 255, 0) 100%);
    position: absolute;
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
    padding: 20px 50px 30px;
    bottom: 0px;
    z-index: 2;
  }
  .copilot-video-card__video-content span {
    font-family: 'OverusedGrotesk', sans-serif !important;
    font-weight: 400;
    font-size: 30px;
    line-height: 30px;
    letter-spacing: 0;
    text-align: center;
    color: #FBFAF3;
  }
  .copilot-video-card__video-content p {
    font-family: 'OverusedGrotesk', sans-serif !important;
    font-weight: 400;
    font-size: 16px;
    line-height: 20px;
    letter-spacing: 0;
    text-align: center;
    color: #FBFAF3;
  }

  /* ===== MOBILE SLIDER ===== */
  @media (max-width: 768px) {
    .copilot-video-stories {
      padding: 40px 0px;
      margin: 0;
    }
    .copilot-video-stories__title {
      font-size: 25px !important;
      line-height: 30px !important;
      margin-bottom: 10px;
      padding: 0 20px;
    }
    .copilot-video-stories__subtitle {
      padding: 0 20px;
    }
    .copilot-video-card__inner {
      margin: 0 auto;
      height: 430px;
      overflow: hidden;
      width: 305px;
    }
    /* — Slider nativo — */
    .js-video-slider {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: scroll;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      gap: 0;
      padding-bottom: 4px;
    }
    .js-video-slider::-webkit-scrollbar { display: none; }
    .js-video-slider .copilot-video-card {
      flex: 0 0 100%;
      width: 100%;
      scroll-snap-align: center;
      padding: 0 16px;
      box-sizing: border-box;
    }

    /* — Bullets pegajosos — */
    .js-video-bullets {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      margin-top: 20px;
    }
    .js-video-bullet {
      height: 6px;
      width: 6px;
      border-radius: 999px;
      background: rgba(255,255,255,0.35);
      border: none;
      padding: 0;
      cursor: pointer;
      transition:
        width 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
        background 0.35s ease;
    }
    .js-video-bullet.is-active {
      width: 24px;
      background: rgba(255,255,255,0.95);
    }
  }
{% endstyle %}

<section class="copilot-video-stories">
  <div class="copilot-video-stories__container">
    {% if section.settings.title != blank %}
      <h2 class="copilot-video-stories__title">
        {{ section.settings.title }}
      </h2>
      <p class="copilot-video-stories__subtitle">
        {{ section.settings.subtitle }}
      </p>
    {% endif %}

    <div class="copilot-video-stories__grid js-video-slider">
      {% for block in section.blocks %}
        <div
          class="copilot-video-card"
          {{ block.shopify_attributes }}
          data-es="{{ block.settings.video_es }}"
        >
          <div class="copilot-video-card__inner">
            {% if block.settings.video_number != blank %}
              <div class="copilot-video-card__video-number">{{ block.settings.video_number }}</div>
            {% endif %}
            <div class="copilot-video-card__video-content">
              {% if block.settings.video_title != blank %}
                <span>{{ block.settings.video_title }}</span>
              {% endif %}
              {% if block.settings.video_subtitle != blank %}
                <p>{{ block.settings.video_subtitle }}</p>
              {% endif %}
            </div>
              {% if block.settings.poster != blank %}
              <img
                class="copilot-video-card__poster"
                src="{{ block.settings.poster | image_url: width: 550 }}"
                alt="poster-video"
                width=""
                height=""
              >
            {% endif %}
            <video muted playsinline preload="metadata"></video>
            {% comment %} <button class="copilot-video-card__play">▶</button> {% endcomment %}
          </div>
        </div>
      {% endfor %}
    </div>
    <div class="js-video-bullets" id="js-video-bullets-{{ section.id }}" style="display:none;"></div>
  </div>
</section>

{% javascript %}
  document.addEventListener('DOMContentLoaded', function () {
    const lang = document.documentElement.lang || 'es';

    document.querySelectorAll('.copilot-video-card').forEach((card) => {
      
      let src = card.dataset.es;
      const video = card.querySelector('video');
      const btn = card.querySelector('.copilot-video-card__play');
      const poster = card.querySelector('.copilot-video-card__poster');

      if (!src) return;

      video.src = src;
      video.muted = true;
      video.playsInline = true;
      video.preload = 'metadata';

      function playFullVideo() {
        video.currentTime = 0;
        video.muted = false;
        video.controls = true;
        card.classList.add('playing');

        if (poster) poster.style.display = 'none';
        if (btn) btn.style.display = 'none';

        video.play().catch(() => {});
      }

      function hoverPreviewStart() {
        if (window.innerWidth <= 768) return;
        if (card.classList.contains('playing')) return;

        video.muted = true;
        video.controls = false;

        if (poster) poster.style.display = 'none';
        //if (btn) btn.style.display = "none";

        video.play().catch(() => {});
      }

      function hoverPreviewStop() {
        if (window.innerWidth <= 768) return;
        if (card.classList.contains('playing')) return;

        video.pause();
        video.currentTime = 0;

        if (poster) poster.style.display = '';
        if (btn) btn.style.display = '';
      }

      if (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          playFullVideo();
        });
      }

      if (poster) {
        poster.addEventListener('click', function () {
          playFullVideo();
        });
      }

      card.addEventListener('mouseenter', hoverPreviewStart);
      card.addEventListener('mouseleave', hoverPreviewStop);

      video.addEventListener('ended', function () {
        if (card.classList.contains('playing')) {
          card.classList.remove('playing');
          video.controls = false;
          video.muted = true;
          video.currentTime = 0;

          if (poster) poster.style.display = '';
          if (btn) btn.style.display = '';
        }
      });
    });
  });

  document.addEventListener('DOMContentLoaded', function () {
    var slider = document.querySelector('.js-video-slider');
    var bulletsWrap = document.querySelector('.js-video-bullets');
    if (!slider || !bulletsWrap) return;

    var cards = slider.querySelectorAll('.copilot-video-card');
    var total = cards.length;
    var dots = [];
    var currentIndex = 0;
    var scrollListener = null;

    function isMobile() { return window.innerWidth <= 768; }

    function buildBullets() {
      bulletsWrap.innerHTML = '';
      dots = [];
      for (var i = 0; i < total; i++) {
        var dot = document.createElement('button');
        dot.className = 'js-video-bullet';
        dot.setAttribute('aria-label', 'Ir a video ' + (i + 1));
        (function (idx) {
          dot.addEventListener('click', function () { goTo(idx); });
        })(i);
        bulletsWrap.appendChild(dot);
        dots.push(dot);
      }
      updateBullets(0);
    }

    function updateBullets(idx) {
      currentIndex = idx;
      dots.forEach(function (d, i) {
        d.classList.toggle('is-active', i === idx);
      });
    }

    function goTo(idx) {
      var cardWidth = cards[0].getBoundingClientRect().width;
      slider.scrollTo({ left: cardWidth * idx, behavior: 'smooth' });
    }

    function onScroll() {
      var cardWidth = cards[0].getBoundingClientRect().width || slider.offsetWidth;
      var idx = Math.round(slider.scrollLeft / cardWidth);
      idx = Math.max(0, Math.min(idx, total - 1));
      if (idx !== currentIndex) updateBullets(idx);
    }

    function setup() {
      if (isMobile() && total > 1) {
        bulletsWrap.style.display = 'flex';
        buildBullets();
        if (!scrollListener) {
          scrollListener = onScroll;
          slider.addEventListener('scroll', scrollListener, { passive: true });
        }
      } else {
        bulletsWrap.style.display = 'none';
        if (scrollListener) {
          slider.removeEventListener('scroll', scrollListener);
          scrollListener = null;
        }
      }
    }

    setup();

    var resizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(setup, 150);
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "Copilot Video Stories",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Historias reales de cuidado"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sub título",
      "default": "Historias reales de cuidado"
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "url",
          "id": "video_es",
          "label": "Video Español"
        },
        {
          "type": "text",
          "id": "video_number",
          "label": "Video Number"
        },
        {
          "type": "text",
          "id": "video_title",
          "label": "Video Title"
        },
        {
          "type": "text",
          "id": "video_subtitle",
          "label": "Video Subtitle"
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Imagen de portada"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Copilot Video Stories"
    }
  ]
}
{% endschema %}
