{% style %}
  .copilot-video-stories {
    background-color: #213529;
    padding: 80px 20px;
    margin: 100px 0 0;
  }

  .copilot-video-stories__container {
    max-width: 1165px;
    margin: 0 auto;
  }

  .copilot-video-stories__title {
    font-family: 'OverusedGrotesk', sans-serif !important;
    color: #fff;
    text-align: center;
    font-size: 50px;
    font-weight: 300;
    line-height: 50px;
    text-align: center;
    margin: 0 auto 20px;
    max-width: 415px;
  }

  .copilot-video-stories__subtitle {
    font-family: 'OverusedGrotesk', sans-serif !important;
    color: #fff;
    text-align: center;
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    text-align: center;
    margin: 0 auto 40px;
    max-width: 470px;
  }

  .copilot-video-stories__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .copilot-video-card {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
  }

  .copilot-video-card video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 24px;
  }

  .copilot-video-card__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.5);
    color: white;
    border: none;
    font-size: 22px;
    cursor: pointer;
  }
  .js-video-slider .slick-track {
    display: flex;
  }
  .copilot-video-card__inner {
    position: relative;
    height: 528px;
    border-radius: 20px;
    backdrop-filter: blur(10px);
    background: #FFFFFF0D;
    -webkit-backdrop-filter: blur(10px);
    box-shadow:
        0px 8px 72px -5px #0000001A,
        0px 2px 30px 0px #0000000D,
        0px 2px 20px 2px #3535350D inset,
        0px 0px 5px 0px #FFFFFF26 inset,
        -1px -1px 0px 0px #FFFFFF66 inset,
        1px 0.5px 0px 0px #FFFFFF99 inset;
  }
  .copilot-video-card__video-number {
    position: absolute;
    display: flex;
    justify-content: center;
    align-items: center;
    color: #FBFAF3;
    font-family: 'OverusedGrotesk', sans-serif !important;
    font-weight: 300;
    font-size: 40px;
    line-height: 60px;
    text-align: center;
    top: 20px;
    right: 20px;
    border: 1px solid #fff;
    padding: 0 0 5px 0;
    border-radius: 50px;
    height: 60px;
    width: 60px;
    z-index: 2;
  }
  .copilot-video-card__poster {
    position: absolute;
  }
  .copilot-video-card__video-content {
    position: absolute;
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
    padding: 20px 50px;
    bottom: 10px;
    z-index: 2;
  }
  .copilot-video-card__video-content span {
    font-family: 'OverusedGrotesk', sans-serif !important;
    font-weight: 400;
    font-size: 30px;
    line-height: 30px;
    letter-spacing: 0;
    text-align: center;
    color: #FBFAF3;
  }
  .copilot-video-card__video-content p {
    font-family: 'OverusedGrotesk', sans-serif !important;
    font-weight: 400;
    font-size: 16px;
    line-height: 20px;
    letter-spacing: 0;
    text-align: center;
    color: #FBFAF3;
  }

  /* ===== MOBILE SLIDER ===== */
  @media (max-width: 768px) {
    .copilot-video-stories {
      padding: 40px 0px;
    }
    .copilot-video-stories__grid {
      display: block;
    }

    .js-video-slider .slick-slide {
      padding: 0 12px;
    }

    .js-video-slider .slick-dots {
      margin-top: 20px;
    }

    .js-video-slider .slick-dots li button:before {
      font-size: 10px;
      color: #a25157;
    }
    .copilot-video-stories__title {
      font-size: 25px !important;
      line-height: 30px !important;
      margin-bottom: 20px;
    }
  }
{% endstyle %}

<section class="copilot-video-stories">
  <div class="copilot-video-stories__container">
    {% if section.settings.title != blank %}
      <h2 class="copilot-video-stories__title">
        {{ section.settings.title }}
      </h2>
      <p class="copilot-video-stories__subtitle">
        {{ section.settings.subtitle }}
      </p>
    {% endif %}

    <div class="copilot-video-stories__grid js-video-slider">
      {% for block in section.blocks %}
        <div
          class="copilot-video-card"
          {{ block.shopify_attributes }}
          data-es="{{ block.settings.video_es }}"
        >
          <div class="copilot-video-card__inner">
            {% if block.settings.video_number != blank %}
              <div class="copilot-video-card__video-number">{{ block.settings.video_number }}</div>
            {% endif %}
            <div class="copilot-video-card__video-content">
              {% if block.settings.video_title != blank %}
                <span>{{ block.settings.video_title }}</span>
              {% endif %}
              {% if block.settings.video_subtitle != blank %}
                <p>{{ block.settings.video_subtitle }}</p>
              {% endif %}
            </div>
              {% if block.settings.poster != blank %}
              <img
                class="copilot-video-card__poster"
                src="{{ block.settings.poster | image_url: width: 550 }}"
                alt="poster-video"
                width=""
                height=""
              >
            {% endif %}
            <video muted playsinline preload="metadata"></video>
            {% comment %} <button class="copilot-video-card__play">▶</button> {% endcomment %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% javascript %}
  document.addEventListener('DOMContentLoaded', function () {
    const lang = document.documentElement.lang || 'es';

    document.querySelectorAll('.copilot-video-card').forEach((card) => {
      
      let src = card.dataset.es;
      const video = card.querySelector('video');
      const btn = card.querySelector('.copilot-video-card__play');
      const poster = card.querySelector('.copilot-video-card__poster');

      if (!src) return;

      video.src = src;
      video.muted = true;
      video.playsInline = true;
      video.preload = 'metadata';

      function playFullVideo() {
        video.currentTime = 0;
        video.muted = false;
        video.controls = true;
        card.classList.add('playing');

        if (poster) poster.style.display = 'none';
        if (btn) btn.style.display = 'none';

        video.play().catch(() => {});
      }

      function hoverPreviewStart() {
        if (window.innerWidth <= 768) return;
        if (card.classList.contains('playing')) return;

        video.muted = true;
        video.controls = false;

        if (poster) poster.style.display = 'none';
        //if (btn) btn.style.display = "none";

        video.play().catch(() => {});
      }

      function hoverPreviewStop() {
        if (window.innerWidth <= 768) return;
        if (card.classList.contains('playing')) return;

        video.pause();
        video.currentTime = 0;

        if (poster) poster.style.display = '';
        if (btn) btn.style.display = '';
      }

      if (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          playFullVideo();
        });
      }

      if (poster) {
        poster.addEventListener('click', function () {
          playFullVideo();
        });
      }

      card.addEventListener('mouseenter', hoverPreviewStart);
      card.addEventListener('mouseleave', hoverPreviewStop);

      video.addEventListener('ended', function () {
        if (card.classList.contains('playing')) {
          card.classList.remove('playing');
          video.controls = false;
          video.muted = true;
          video.currentTime = 0;

          if (poster) poster.style.display = '';
          if (btn) btn.style.display = '';
        }
      });
    });
  });

  document.addEventListener('DOMContentLoaded', function () {
    const slider = document.querySelector('.js-video-slider');
    if (!slider || typeof $ === 'undefined' || !$.fn.slick) return;

    function initVideoSlider() {
      if (window.innerWidth <= 768) {
        if (!$(slider).hasClass('slick-initialized')) {
          $(slider).slick({
            slidesToShow: 1,
            slidesToScroll: 1,
            infinite: true,
            centerMode: true,
            centerPadding: '60px',
            arrows: false,
            dots: true,
            adaptiveHeight: false,
          });
        }
      } else {
        if ($(slider).hasClass('slick-initialized')) {
          $(slider).slick('unslick');
        }
      }
    }

    initVideoSlider();
    window.addEventListener('resize', initVideoSlider);
  });
{% endjavascript %}

{% schema %}
{
  "name": "Copilot Video Stories",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Historias reales de cuidado"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sub título",
      "default": "Historias reales de cuidado"
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "url",
          "id": "video_es",
          "label": "Video Español"
        },
        {
          "type": "text",
          "id": "video_number",
          "label": "Video Number"
        },
        {
          "type": "text",
          "id": "video_title",
          "label": "Video Title"
        },
        {
          "type": "text",
          "id": "video_subtitle",
          "label": "Video Subtitle"
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Imagen de portada"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Copilot Video Stories"
    }
  ]
}
{% endschema %}
