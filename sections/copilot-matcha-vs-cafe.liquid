<section class="copilot-table-section section-{{ section.id }}-padding" id="copilot-table-{{ section.id }}">
  <div class="copilot-table-container">
    <!-- Title / Header Area -->
    <div class="copilot-table__header">
      {% if section.settings.title != blank %}
        <h2 class="copilot-table__title">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.subtitle != blank %}
        <p class="copilot-table__subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>

    <!-- Main Table Area -->
    <div class="copilot-table__main-content">
      <div class="copilot-table__wrapper">
        <table class="copilot-table">
          <colgroup>
            <col class="copilot-table__col-feature" style="width: 32%;">
            <col class="copilot-table__col-highlight" style="width: 36%;">
            <col class="copilot-table__col-other" style="width: 32%;">
          </colgroup>
          <thead>
            <tr class="copilot-table__header-row">
              <!-- Top-left cell is empty -->
              <th class="copilot-table__header-cell copilot-table__header-cell--empty"></th>

              <!-- Edward Fields Column Header -->
              <th class="copilot-table__header-cell copilot-table__header-cell--highlight">
                {% if section.settings.matcha_img != blank %}
                  <div class="copilot-table__header-image-wrapper">
                    {{
                      section.settings.matcha_img
                      | image_url: width: 250
                      | image_tag: class: 'copilot-table__header-image', loading: 'lazy'
                    }}
                  </div>
                {% endif %}
                <span class="copilot-table__header-label">{{ section.settings.matcha_label }}</span>
              </th>

              <!-- Coffee Column Header -->
              <th class="copilot-table__header-cell">
                {% if section.settings.cafe_img != blank %}
                  <div class="copilot-table__header-image-wrapper">
                    {{
                      section.settings.cafe_img
                      | image_url: width: 250
                      | image_tag: class: 'copilot-table__header-image', loading: 'lazy'
                    }}
                  </div>
                {% endif %}
                <span class="copilot-table__header-label">{{ section.settings.coffee_label }}</span>
              </th>
            </tr>
          </thead>
          <tbody>
            {% for block in section.blocks %}
              <tr class="copilot-table__row" {{ block.shopify_attributes }}>
                <!-- Feature Column -->
                <td class="copilot-table__cell copilot-table__cell--feature">
                  {{ block.settings.feature_name }}
                </td>

                <!-- Highlighted Column (Edward Fields) -->
                <td class="copilot-table__cell copilot-table__cell--highlight">
                  {{ block.settings.matcha_value }}
                </td>

                <!-- Other Column (Coffee) -->
                <td class="copilot-table__cell copilot-table__cell--other">
                  {{ block.settings.coffee_value }}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      <!-- Footer Text centered below the table -->
      {% if section.settings.footer_text != blank %}
        <p class="copilot-table__footer">{{ section.settings.footer_text }}</p>
      {% endif %}
    </div>
  </div>
</section>

<style>
  /* --- CUSTOMIZABLE COLORS & VARS (Modify in your stylesheet if needed) --- */
  #copilot-table-{{ section.id }} {
    --copilot-table-highlight-bg: #E3EDE7;  /* Color de fondo para la columna destacada (Edward Fields) */
    --copilot-table-border-color: #E8E6DF;  /* Color de los bordes divisorios */
  }

  /* --- LAYOUT & STRUCTURE --- */
  .copilot-table-section {
    display: block;
    width: 100%;
    box-sizing: border-box;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .copilot-table-container {
    display: flex;
    flex-direction: column !important;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  /* Title Header block */
  .copilot-table__header {
    margin-bottom: 0;
    box-sizing: border-box;
    max-width: 300px;
  }

  .copilot-table__title {
    font-family: "OverusedGrotesk", sans-serif !important;
    font-weight: 300;
    font-size: 50px;
    line-height: 50px;
    letter-spacing: 0;
    color: #213529;
    margin: 0;
    text-transform: none;
  }

  .copilot-table__subtitle {
    margin: 0;
  }

  /* Main Table Content columns */
  .copilot-table__main-content {
    display: flex;
    flex-direction: column;
    width: 100%;
    box-sizing: border-box;
  }

  .copilot-table__wrapper {
    width: 100%;
    box-sizing: border-box;
    margin: 0 auto 30px;
    max-width: 965px;
  }

  /* Semantic Table Setup */
  .copilot-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    table-layout: fixed;
  }

  /* Table cells alignment & padding */
  .copilot-table td,
  .copilot-table th {
    padding: 18px 16px;
    border-bottom: 1px solid var(--copilot-table-border-color);
    vertical-align: middle;
    box-sizing: border-box;
  }

  .copilot-table th {
    background-color: #fff;
    font-weight: 500;
  }

  .copilot-table__header-cell--empty {
    border-bottom: 1px solid transparent !important;
  }

  /* Header Image constraints */
  .copilot-table__header-image-wrapper {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    height: 100px; /* Mantiene las imágenes alineadas a la base de forma consistente */
  }

  .copilot-table__header-image {
    {% comment %} max-width: 100%;
    max-height: 100%; {% endcomment %}
    width: auto;
    height: 200px;
    object-fit: contain;
  }

  .copilot-table__header-label {
    display: block;
    margin-top: auto;
  }

  /* Column Alignments */
  .copilot-table__cell--feature,
  .copilot-table__header-cell--empty {
    text-align: left;
  }

  .copilot-table__cell--highlight,
  .copilot-table__header-cell--highlight {
    text-align: center;
  }

  .copilot-table__cell--other,
  .copilot-table th:nth-child(3) {
    text-align: center;
  }

  /* Column Highlight Background Style */
  .copilot-table__cell--highlight,
  .copilot-table__header-cell--highlight {
    background-color: var(--copilot-table-highlight-bg);
  }

  /* Rounded top corners on highlighted column header */
  .copilot-table__header-cell--highlight {
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
  }

  /* Rounded bottom corners on highlighted column base */
  .copilot-table tr:last-child td.copilot-table__cell--highlight {
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
  }

  /* Clean up bottom borders on last row */
  .copilot-table tr:last-child td {
    border-bottom: none;
  }

  .copilot-table td, 
  .copilot-table th {
    font-family: "OverusedGrotesk", sans-serif !important;
    font-weight: 400;
    font-size: 16px;
    line-height: 20px;
    letter-spacing: 0;
    color: #213529;
  }

  /* Table Footer styling */
  .copilot-table__footer {
    font-family: "OverusedGrotesk", sans-serif !important;
    font-weight: 400;
    font-size: 16px;
    line-height: 24px;
    letter-spacing: 0.22px;
    text-align: center;
    color: #213529;
    text-align: center;
    margin: 0 auto;
    max-width: 600px;
    box-sizing: border-box;
  }

  /* --- MOBILE RESPONSIVE --- */
  @media (max-width: 767px) {
    .copilot-table-container {
      padding: 0 16px;
    }

    .copilot-table td,
    .copilot-table th {
      padding: 14px 10px; /* Padding más ajustado en celulares */
    }

    .copilot-table__header-image-wrapper {
      height: 70px; /* Imágenes más compactas en celulares */
    }
  }
</style>

{% schema %}
{
  "name": "Copilot - Tabla Matcha",
  "settings": [
    {
      "type": "header",
      "content": "Textos Principales"
    },
    {
      "type": "text",
      "id": "title",
