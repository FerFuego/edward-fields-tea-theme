{%  assign section_containers = containers %}
{%  assign section_blocks = blocks %}
{%- for b in section_blocks -%}
  {%- if b.settings.parent_container_name == container.settings.container_name -%}
    <div class="nested-block nested-block--{{ b.type }}">
      {%- case b.type -%}
        {%- when 'heading' -%}
          <{{ b.settings.heading_tag }} style="
            color: {{ b.settings.color }}; 
            font-size: {{ b.settings.font_size }}; 
            font-weight: {{ b.settings.font_weight }}; 
            margin: {{ b.settings.margin }}; 
            padding: {{ b.settings.padding }};
            width: {{ b.settings.width }};
          ">
            {{ b.settings.text }}
          </{{ b.settings.heading_tag }}>
        {%- when 'text' -%}
          <p style="
            color: {{ b.settings.color }};
            font-size: {{ b.settings.font_size }};
            font-weight:  {{ b.settings.font_weight }};
            line-height:  {{ b.settings.line_height }};
            text-align: {{ b.settings.text_align }};
            margin: {{ b.settings.margin }};
            padding: {{ b.settings.padding }};
          ">
            {{ b.settings.text }}
          </p>
        {%- when 'richtext' -%}
          <div style="
            color: {{ b.settings.color }};
            font-size: {{ b.settings.font_size }};
            font-weight:  {{ b.settings.font_weight }};
            line-height:  {{ b.settings.line_height }};
            text-align: {{ b.settings.text_align }};
            margin: {{ b.settings.margin }};
            padding: {{ b.settings.padding }};
          ">
            {{ b.settings.text }}
          </div>
        {%- when 'image' -%}
          {%- assign desktop_image = b.settings.image -%}
          {%- assign mobile_image = b.settings.image_mobile -%}

          <picture>
            
            {%- if mobile_image != blank -%}
              <source 
                media="(max-width: 767px)" 
                srcset="{{ mobile_image | image_url: width: 600 }}"
              >
            {%- endif -%}

            {%- if desktop_image != blank -%}
              <img 
                src="{{ desktop_image | image_url: width: 1200 }}" 
                alt="Imagen"
                style="
                  width: {{ b.settings.width }};
                  height: {{ b.settings.height }};
                  margin: {{ b.settings.margin }};
                  padding: {{ b.settings.padding }};
                  border-radius: {{ b.settings.border_radius }};
                "
                loading="lazy"
              />
            {%- endif -%}

          </picture>
        {%- when 'button' -%}
          <a href="{{ b.settings.url }}" class="button" style="
            background-color: {{ b.settings.background_color }};
            color: {{ b.settings.color }};
            font-size: {{ b.settings.font_size }};
            font-weight:  {{ b.settings.font_weight }};
            line-height:  {{ b.settings.line_height }};
            padding: {{ b.settings.padding }};
            margin: {{ b.settings.margin }};
            border: {{ b.settings.border }};
            border-radius: {{ b.settings.border_radius }};
            width: {{ b.settings.width }};
            height: {{ b.settings.height }};
            text-decoration: none;
            display: {{ b.settings.layout }};
            justify-content: {{ b.settings.justify_content }};
            align-items: {{ b.settings.align_items }};
          ">
            {{ b.settings.label }}
          </a>
        {%- when 'video' -%}
          {{ 'video-section.css' | asset_url | stylesheet_tag }}
          {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
          {%- assign video = b.settings.video -%}
          {%- assign video_url = b.settings.video_url -%}
          {%- assign poster = b.settings.cover_image -%}
          {%- assign loop = b.settings.enable_video_looping -%}
        
          <div class="flexible-video-block" style="
            width: {{ b.settings.width }};
            height: {{ b.settings.height }};
            margin: {{ b.settings.margin }};
            padding: {{ b.settings.padding }};
            border-radius: {{ b.settings.border_radius }};
            overflow: hidden;
          ">
            {% comment %}
              Video embebido: si hay video directo lo mostramos,
              si no usamos video_url (youtube/vimeo)
            {% endcomment %}
        
            {%- if video != blank -%}
              {{ video | video_tag: autoplay: false, loop: loop, controls: true, width: b.settings.width, height: b.settings.height }}
            {%- elsif video_url != blank -%}
              {%- assign video_id = '' -%}
              {%- assign video_type = '' -%}
              {%- if video_url contains 'youtube.com' or video_url contains 'youtu.be' -%}
                {%- assign video_type = 'youtube' -%}
                {%- if video_url contains 'v=' -%}
                  {%- assign video_id = video_url | split: 'v=' | last | split: '&' | first -%}
                {%- elsif video_url contains 'youtu.be/' -%}
                  {%- assign video_id = video_url | split: 'youtu.be/' | last | split: '?' | first -%}
                {%- endif -%}
              {%- elsif video_url contains 'vimeo.com' -%}
                {%- assign video_type = 'vimeo' -%}
                {%- assign video_id = video_url | split: '/' | last -%}
              {%- endif -%}

              {%- if video_type == 'youtube' and video_id != blank -%}

                <div class="video-wrapper" data-video-id="{{ video_id }}">
                  
                  {% if poster != blank %}
                    <div class="video-poster js-video-poster">
                      <img
                        src="{{ poster | image_url: width: 1600 }}"
                        alt="Video cover"
                        width="100%"
                        height="100%"
                        loading="lazy"
                      >
                      <button class="video-play-btn">▶</button>
                    </div>
                  {% endif %}

                  <iframe
                    class="js-video-iframe"
                    width="100%"
                    height="100%"
                    data-src="https://www.youtube.com/embed/{{ video_id }}?autoplay=1&rel=0&loop={% if loop %}1&playlist={{ video_id }}{% else %}0{% endif %}"
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                    loading="lazy"
                    style="display:none;"
                  ></iframe>
                </div>
              {%- elsif video_type == 'vimeo' and video_id != blank -%}
                <iframe
                  src="https://player.vimeo.com/video/{{ video_id }}?loop={% if loop %}1{% else %}0{% endif %}&autoplay=0&muted=0"
                  width="100%" height="100%"
                  frameborder="0"
                  allow="autoplay; fullscreen; picture-in-picture"
                  allowfullscreen
                  loading="lazy"
                ></iframe>
              {%- else -%}
                <p>Video URL inválido o no soportado</p>
              {%- endif -%}
            {%- else -%}
              <p>No hay video disponible</p>
            {%- endif -%}
          </div>
        {% when 'contact_form' %}
          {%- assign form_type = b.settings.form_type | default: 'profesional' -%}
          {%- assign form_id = b.id | default: section.id | prepend: 'ContactForm-' -%}
          <div class="contact-form" {{ b.shopify_attributes }}>

            {%- if form_type == 'profesional' -%}

              {%- form 'contact', id: form_id, class: 'contact-form__form' -%}
                {%- if form.errors -%}
                  <div class="contact-form__error" tabindex="-1" autofocus>
                    {{ form.errors.translated_fields.email | capitalize }}
                    {{ form.errors.messages.email }}
                  </div>
                {%- endif -%}
                {%- if form.posted_successfully? -%}
                  <div class="contact-form__success" tabindex="-1" autofocus>
                    {{ 'blocks.contact_form.post_success' | t }}
                  </div>
                {%- else -%}
                    <div class="contact-form__form-row">
                      <input type="text" id="{{ form_id }}-name" class="contact-form__input"
                        autocomplete="name" name="contact[name]"
                        value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                        aria-required="true"
                        {% if form.errors contains 'name' %}aria-invalid="true"{% endif %}
                        placeholder="Nombre y apellido">
                    </div>
                    <div class="contact-form__form-row">
                      <input type="email" id="{{ form_id }}-email" class="contact-form__input"
                        autocomplete="email" name="contact[email]" spellcheck="false" autocapitalize="off"
                        value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                        aria-required="true"
                        {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}
                        placeholder="Email Profesional">
                    </div>
                    <div class="contact-form__form-row">
                      <input type="text" id="{{ form_id }}-empresa" class="contact-form__input"
                        name="contact[empresa]"
                        value="{% if form.empresa %}{{ form.empresa }}{% endif %}"
                        aria-required="true"
                        {% if form.errors contains 'empresa' %}aria-invalid="true"{% endif %}
                        placeholder="Centro de Trabajo">
                    </div>
                    <div class="contact-form__form-row">
                      <select id="{{ form_id }}-motivo" 
                        class="contact-form__input" 
                        aria-required="true"
                        {% if form.errors contains 'motivo' %}aria-invalid="true"{% endif %}
                        name="contact[motivo]">
                        <option value="" disabled selected>Profesión</option>
                        <option value="enfermero" {% if form.motivo == "enfermero" %}selected{% endif %}>Enfermero/a</option>
                        <option value="doctor"    {% if form.motivo == "doctor"    %}selected{% endif %}>Doctor/a</option>
                        <option value="cirujano"  {% if form.motivo == "cirujano"  %}selected{% endif %}>Cirujano/a</option>
                        <option value="otro"      {% if form.motivo == "otro"      %}selected{% endif %}>Otro</option>
                      </select>
                    </div>
                    <div class="contact-form__form-row contact-form__form-row--checkbox">
                      <div class="form-row">
                          <input type="hidden" name="contact[privacy]" value="not-accepted">
                          <input type="checkbox" id="{{ form_id }}-privacy" class="contact-form__checkbox"
                            name="contact[privacy]" value="accepted"
                            {% if form.privacy == "accepted" %}checked{% endif %}>
                          <label for="{{ form_id }}-privacy">Estoy de acuerdo con la política de privacidad</label>
                       </div>
                    </div>
                    <button type="submit" class="button submit-button">Solicita tu kit</button>
                {%- endif -%}
              {%- endform -%}

            {%- elsif form_type == 'contacto' -%}

              {%- form 'contact', id: form_id, class: 'contact-form__form' -%}
                {%- if form.errors -%}
                  <div class="contact-form__error" tabindex="-1" autofocus>
                    {{ form.errors.translated_fields.email | capitalize }}
                    {{ form.errors.messages.email }}
                  </div>
                {%- endif -%}
                {%- if form.posted_successfully? -%}
                  <div class="contact-form__success" tabindex="-1" autofocus>
                    {{ 'blocks.contact_form.post_success' | t }}
                  </div>
                {%- else -%}
                  <div class="contact-form__form-row">
                    <input type="text" id="{{ form_id }}-name" class="contact-form__input"
                      autocomplete="name" name="contact[name]"
                      value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                      aria-required="true"
                      {% if form.errors contains 'name' %}aria-invalid="true"{% endif %}
                      placeholder="Nombre y apellido">
                  </div>
                  <div class="contact-form__form-row">
                    <input type="email" id="{{ form_id }}-email" class="contact-form__input"
                      autocomplete="email" name="contact[email]" spellcheck="false" autocapitalize="off"
                      value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                      aria-required="true"
                      {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}
                      placeholder="Email">
                  </div>
                  <div class="contact-form__form-row">
                    <input type="tel" id="{{ form_id }}-phone" class="contact-form__input"
                      name="contact[telefono]"
                      value="{% if form.telefono %}{{ form.telefono }}{% endif %}"
                      aria-required="true"
                      {% if form.errors contains 'telefono' %}aria-invalid="true"{% endif %}
                      placeholder="Teléfono">
                  </div>
                  <div class="contact-form__form-row">
                    <textarea id="{{ form_id }}-message" class="contact-form__input"
                      name="contact[body]" rows="4"
                      aria-required="true"
                      {% if form.errors contains 'body' %}aria-invalid="true"{% endif %}
                      placeholder="Tu consulta...">{% if form.body %}{{ form.body }}{% endif %}</textarea>
                  </div>
                  <div class="contact-form__form-row contact-form__form-row--checkbox">
                    <div class="form-row">
                      <input type="hidden" name="contact[privacy]" value="not-accepted">
                      <input type="checkbox" id="{{ form_id }}-privacy" class="contact-form__checkbox"
                        name="contact[privacy]" value="accepted"
                        {% if form.privacy == "accepted" %}checked{% endif %}>
                      <label for="{{ form_id }}-privacy">Estoy de acuerdo con la política de privacidad</label>
                    </div>
                  </div>
                  <button type="submit" class="button submit-button">Enviar consulta</button>
                {%- endif -%}
              {%- endform -%}

            {%- endif -%}

          </div>
        {%- when 'menu' -%}

          {%- assign selected_menu = linklists[b.settings.menu] -%}

          {% if selected_menu.links.size > 0 %}
            <ul style="
              list-style:none;
              padding:0;
              margin:0;
              display:flex;
              flex-direction: {{ b.settings.direction }};
              gap: {{ b.settings.gap }};
            ">
              {% for link in selected_menu.links %}
                <li>
                  <a href="{{ link.url }}" style="
                    color: {{ b.settings.color }};
                    font-size: {{ b.settings.font_size }};
                    font-weight: {{ b.settings.font_weight }};
                    text-decoration:none;
                  ">
                    {{ link.title }}
                  </a>
                </li>
              {% endfor %}
            </ul>
          {% endif %}

        {%- when 'social_links' -%}
          {%- liquid
            assign facebook = b.settings.social_facebook_link
            assign instagram_es = b.settings.social_instagram_link
            assign instagram_it = b.settings.social_instagram_link_it
            assign instagram_pt = b.settings.social_instagram_link_pt
            assign youtube = b.settings.social_youtube_link
            assign tiktok = b.settings.social_tiktok_link
            assign twitter = b.settings.social_twitter_link
            assign x = b.settings.social_x_link
            assign threads = b.settings.social_threads_link
            assign linkedin = b.settings.social_linkedin_link
            assign spotify = b.settings.social_spotify_link

            assign xlink = x | default: twitter

            assign target = ''
            assign rel = ''
            if b.settings.open_new_tab
              assign target = ' target="_blank"'
              assign rel = ' rel="noopener noreferrer"'
            endif
  
            capture social_style
              echo "display:flex;align-items:center;justify-content:center;"
              echo "background:" | append: b.settings.bg_color | append: ";"
              echo "border:1px solid " | append: b.settings.border_color | append: ";"
              echo "border-radius:" | append: b.settings.border_radius | append: ";"
              echo "padding:" | append: b.settings.padding | append: ";"
            endcapture

            capture icon_style
              echo "width:" | append: b.settings.icon_size | append: "px;"
              echo "height:" | append: b.settings.icon_size | append: "px;"
              echo "fill:" | append: b.settings.icon_color | append: ";"
            endcapture
          %}

          <div style="
            display:flex;
            align-items:center;
            gap: {{ b.settings.gap }};
            flex-wrap:wrap;
          ">

            {% if facebook != blank %}
              <a href="{{ facebook }}"{{ target }}{{ rel }} style="{{ social_style }}">
                <svg viewBox="0 0 24 24" style="{{ icon_style }}">
                  <path d="M22 12a10 10 0 1 0-11.56 9.87v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.23.2 2.23.2v2.46h-1.25c-1.23 0-1.62.76-1.62 1.54V12h2.76l-.44 2.88h-2.32v6.99A10 10 0 0 0 22 12z"/>
                </svg>
              </a>
            {% endif %}

            {% if instagram_es != blank %}

              <a id="instagram-link" href="#"{{ target }}{{ rel }} style="{{ social_style }}">
                <svg viewBox="0 0 24 24" style="{{ icon_style }}">
                  <path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm10 2H7a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3zm-5 4a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/>
                </svg>
              </a>

              {% comment %} Cambia segun idioma weglot {% endcomment %}
              <script>
                (function() {
                  const lang = document.documentElement.lang || 'es';

                  const links = {
                    es: "{{ instagram_es }}",
                    it: "{{ instagram_it }}",
                    pt: "{{ instagram_pt }}"
                  };

                  const link = document.getElementById('instagram-link');
                  if (!link) return;

                  link.href = links[lang] || links.es;
                })();
              </script>

            {% endif %}

            {% if youtube != blank %}
              <a href="{{ youtube }}"{{ target }}{{ rel }} style="{{ social_style }}">
                <svg viewBox="0 0 24 24" style="{{ icon_style }}">
                  <path d="M21.6 7.2a3 3 0 0 0-2.1-2.1C17.9 4.7 12 4.7 12 4.7s-5.9 0-7.5.4A3 3 0 0 0 2.4 7.2 31 31 0 0 0 2 12a31 31 0 0 0 .4 4.8 3 3 0 0 0 2.1 2.1c1.6.4 7.5.4 7.5.4s5.9 0 7.5-.4a3 3 0 0 0 2.1-2.1A31 31 0 0 0 22 12zM10 15.5v-7l6 3.5-6 3.5z"/>
                </svg>
              </a>
            {% endif %}

            {% if tiktok != blank %}
              <a href="{{ tiktok }}"{{ target }}{{ rel }} style="{{ social_style }}">
                <svg viewBox="0 0 24 24" style="{{ icon_style }}">
                  <path d="M16.5 3c.5 2.9 2.6 4.9 5.5 5.2v3.1c-2-.1-3.8-.7-5.5-1.8V16a6 6 0 1 1-6-6c.4 0 .8 0 1.2.1v3.3a2.9 2.9 0 1 0 2.2 2.8V3h2.6z"/>
                </svg>
              </a>
            {% endif %}

            {% if xlink != blank %}
              <a href="{{ xlink }}"{{ target }}{{ rel }} style="{{ social_style }}">
                <svg viewBox="0 0 24 24" style="{{ icon_style }}">
                  <path d="M18.9 2H22l-6.8 7.8L23 22h-6.9l-5.4-7.1L4.7 22H1.6l7.3-8.4L1 2h7.1l4.9 6.4L18.9 2z"/>
                </svg>
              </a>
            {% endif %}

            {% if spotify != blank %}
              <a href="{{ spotify }}"{{ target }}{{ rel }} style="{{ social_style }}">
                <svg xmlns="http://www.w3.org/2000/svg" style="{{ icon_style }}" viewBox="0 0 168 168" fill="currentColor" aria-hidden="true">
                  <path d="M84 0a84 84 0 1 0 0 168A84 84 0 0 0 84 0Zm38.53 121.19a5.23 5.23 0 0 1-7.2 1.72c-19.72-12.05-44.55-14.78-73.82-8.12a5.24 5.24 0 0 1-2.33-10.21c32.03-7.31 59.47-4.2 81.61 9.33a5.23 5.23 0 0 1 1.74 7.28Zm10.28-22.87a6.55 6.55 0 0 1-9.01 2.15c-22.57-13.87-56.98-17.89-83.68-9.8a6.55 6.55 0 1 1-3.8-12.54c30.49-9.25 68.4-4.77 94.33 11.17a6.55 6.55 0 0 1 2.16 9.02Zm.88-23.82c-27.07-16.08-71.74-17.57-97.58-9.05a7.86 7.86 0 1 1-4.92-14.93c29.66-9.78 78.97-7.89 110.51 10.85a7.86 7.86 0 0 1-8.01 13.13Z"/>
                </svg>
              </a>
            {% endif %}

          </div>
        {%- when 'popup_trigger' -%}
          <button
            type="button"
            class="copilot-popup-trigger"
            data-popup-target="{{ b.settings.popup_id }}"
            style="
              background-color: {{ b.settings.background_color }};
              color: {{ b.settings.color }};
              font-size: {{ b.settings.font_size }};
              font-weight: {{ b.settings.font_weight }};
              padding: {{ b.settings.padding }};
              margin: {{ b.settings.margin }};
              border: {{ b.settings.border }};
              border-radius: {{ b.settings.border_radius }};
              width: {{ b.settings.width }};
              cursor: pointer;
            "
            {{ b.shopify_attributes }}
          >
            {{ b.settings.label }}
          </button>

        {% comment %} End {% endcomment %}
      {%- endcase -%}
    </div>
  {%- endif -%}
{%- endfor -%}